package SUS;
import java.util.Scanner;
public class Imposter6 {
    
	public static void main(String[] args) {
		
        int n = Integer.parseInt(args[0]);
        int[][] a = new int[n][n];
        int[][] b = new int[n][n];

        Scanner sc = new Scanner(System.in);
        
        for(int i = 0; i < n ; i++){
            for(int j = 0; j < n; j++){
                System.out.printf("Enter the matrix A for the place %d: ", i + 1);
                a[i][j] = sc.nextInt();
                
            }
        }
        System.out.printf("\n");
            
        for(int i = 0; i < n ; i++){
            for(int j = 0; j < n; j++){
                System.out.printf("Enter the matrix B for the place %d: ", i + 1);
                b[i][j] = sc.nextInt();
            }

        }
    }
    
}
